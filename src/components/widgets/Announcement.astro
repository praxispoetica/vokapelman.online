---
import { Icon } from 'astro-icon/components';

// Thin bar above the header. Everything is a prop so a site can change the
// message without touching the component; the defaults reproduce the demo.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const {
  badge = 'NEW',
  text = 'Astro v7 is now available! »',
  href = 'https://astro.build/blog/astro-7/',
  showStars = true,
} = Astro.props;
---

<div
  class="text-sm bg-slate-900 text-slate-300 dark:bg-transparent dark:border-b dark:border-slate-800 dark:text-slate-400 hidden lg:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
>
  {
    badge && (
      <span class="bg-white/20 dark:bg-slate-700 text-slate-100 dark:text-slate-300 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
        {badge}
      </span>
    )
  }
  {
    text &&
      (href ? (
        <a href={href} class="text-slate-300 hover:underline dark:text-slate-400 font-medium" set:html={text} />
      ) : (
        <span class="text-slate-300 dark:text-slate-400 font-medium" set:html={text} />
      ))
  }
  {
    showStars && (
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="ltr:ml-auto rtl:mr-auto ml-auto inline-flex items-center gap-2 text-muted hover:text-black dark:hover:text-white transition duration-150 ease-in-out text-sm"
        title="PraxisPoetica Publish in Public - vokapelman website repo"
        href="https://github.com/praxispoetica/vokapelman.online"
      >
        {/* 1. The Icon */}
        <Icon name="tabler:brand-github" class="w-5 h-5 inline-block align-middle text-white hover:text-sky-400" />

        {/* 2. The Text Phrase (Cleaned up colors for global compatibility) */}
        <span class="inline-block align-middle font-medium text-xs md:text-sm px-1.5 py-0.5 rounded-sm bg-muted dark:bg-slate-700 text-slate-300 dark:text-slate-100 hover:text-sky-500 transition-colors">
          PraxisPoetica Publish in Public
        </span>
        {/* 3. for Accessibility */}
        <span class="sr-only">GitHub Repository for this website: PraxisPoetica Publish in Public</span>
      </a>
    )
  }
</div>
