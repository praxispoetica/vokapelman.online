---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

export interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  buttonText?: string;
  url?: string;
  disclaimer?: string;
  layout?: 'band' | 'card';
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  buttonText = 'Subscribe on Substack',
  url = 'https://vokapelman.substack.com',
  disclaimer = 'Free to read. Unsubscribe anytime.',
  layout = 'band',

  id = 'newsletter',
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div
    class:list={[
      'rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm',
      layout === 'band'
        ? 'flex flex-col gap-8 p-8 md:p-10 lg:flex-row lg:items-center lg:justify-between'
        : 'mx-auto max-w-2xl p-8 text-center',
    ]}
  >
    <div class:list={[layout === 'band' ? 'lg:max-w-xl' : '']}>
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container:
            layout === 'band' ? 'mb-0 md:mb-0 text-center lg:text-left rtl:lg:text-right md:mx-0' : 'mb-6 md:mb-6',
          title: 'text-2xl md:text-3xl',
          subtitle: 'text-base md:text-lg mt-2',
          ...((classes?.headline as Record<string, string>) ?? {}),
        }}
      />
    </div>
    <div
      class:list={[
        'flex flex-col items-center lg:items-end gap-2 shrink-0',
        layout === 'band' ? 'lg:max-w-md' : 'mx-auto max-w-md',
      ]}
    >
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary inline-flex items-center justify-center whitespace-nowrap px-7 py-3 text-base shadow-sm hover:shadow transition"
      >
        <span>{buttonText}</span>
        <Icon name="tabler:arrow-right" class="ml-2 h-5 w-5 rtl:ml-0 rtl:mr-2 rtl:rotate-180" />
      </a>
      {disclaimer && <p class="text-xs text-muted text-center lg:text-right" set:html={disclaimer} />}
    </div>
  </div>
</WidgetWrapper>
