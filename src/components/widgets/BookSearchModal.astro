---
import { Icon } from 'astro-icon/components';

export interface Props {
  bookSlug: string;
  bookTitle: string;
}

const { bookSlug, bookTitle } = Astro.props;
---

<book-search data-book-slug={bookSlug} data-book-title={bookTitle}>
  <dialog
    id="book-search-dialog"
    class="book-search-dialog fixed inset-0 m-auto z-50 p-0 max-w-xl w-[calc(100%-2rem)] rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-gray-200 dark:border-slate-800 text-default overflow-hidden flex flex-col max-h-[80vh]"
    aria-label={`Search "${bookTitle}" preview`}
  >
    <!-- Search Input Header -->
    <div class="flex items-center border-b border-gray-200 dark:border-slate-800 px-4 py-3 gap-3">
      <Icon name="tabler:search" class="w-5 h-5 text-muted shrink-0" />
      <label for="book-search-input" class="sr-only">Search {bookTitle}</label>
      <input
        id="book-search-input"
        type="search"
        data-search-input
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder={`Search "${bookTitle}" preview...`}
        class="w-full bg-transparent text-base text-default placeholder:text-muted focus:outline-none"
      />
      <button
        type="button"
        data-search-clear
        class="hidden p-1 text-muted hover:text-default rounded transition cursor-pointer"
        aria-label="Clear query"
      >
        <Icon name="tabler:x" class="w-4 h-4" />
      </button>
      <button
        type="button"
        data-search-close
        class="p-1 text-muted hover:text-default rounded sm:hidden transition cursor-pointer"
        aria-label="Close search"
      >
        <span class="text-sm font-medium">Cancel</span>
      </button>
      <kbd
        class="hidden sm:inline-block px-1.5 py-0.5 text-[11px] font-mono text-muted bg-gray-100 dark:bg-slate-800 rounded border border-gray-300 dark:border-slate-700"
      >
        ESC
      </kbd>
    </div>

    <!-- Results List -->
    <div class="flex-1 overflow-y-auto p-3 space-y-1 divide-y divide-gray-100 dark:divide-slate-800/60">
      <div data-search-placeholder class="py-12 text-center text-muted text-sm">
        <p class="font-medium text-default mb-1">Search the online preview</p>
        <p class="text-xs">Type a keyword, character name, or scene heading to search.</p>
      </div>
      <div data-search-loading class="hidden py-12 text-center text-muted text-sm">
        <div class="inline-block w-5 h-5 border-2 border-primary border-t-transparent rounded-full animate-spin mb-2">
        </div>
        <p class="text-xs">Loading preview index…</p>
      </div>
      <div data-search-empty class="hidden py-12 text-center text-muted text-sm">
        <p class="font-medium text-default mb-1">No matching results found</p>
        <p class="text-xs">Try different search terms or check spelling.</p>
      </div>
      <ul data-search-list class="space-y-1"></ul>
    </div>

    <!-- Footer Bar -->
    <div
      class="px-4 py-2.5 border-t border-gray-100 dark:border-slate-800/80 bg-gray-50/60 dark:bg-slate-950/40 text-xs text-muted flex items-center justify-between"
    >
      <div class="hidden sm:flex items-center gap-3">
        <span>
          <kbd
            class="font-mono bg-white dark:bg-slate-800 px-1 py-0.5 rounded border border-gray-200 dark:border-slate-700"
            >↑</kbd
          >
          <kbd
            class="font-mono bg-white dark:bg-slate-800 px-1 py-0.5 rounded border border-gray-200 dark:border-slate-700"
            >↓</kbd
          > to navigate
        </span>
        <span>
          <kbd
            class="font-mono bg-white dark:bg-slate-800 px-1 py-0.5 rounded border border-gray-200 dark:border-slate-700"
            >↵</kbd
          > to select
        </span>
        <span>
          <kbd
            class="font-mono bg-white dark:bg-slate-800 px-1 py-0.5 rounded border border-gray-200 dark:border-slate-700"
            >esc</kbd
          > to close
        </span>
      </div>
      <span class="ml-auto text-[11px] text-muted">Preview search</span>
    </div>
  </dialog>
</book-search>

<style>
  book-search {
    display: contents;
  }
  book-search dialog:not([open]) {
    display: none !important;
  }
  book-search dialog[open] {
    display: flex !important;
  }
  book-search dialog::backdrop {
    background-color: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
</style>

<script>
  interface SearchItem {
    id: string;
    chapterTitle: string;
    sceneTitle: string;
    url: string;
    text: string;
  }

  // Cache search indexes across client-side page transitions
  const indexCache = new Map<string, SearchItem[]>();
  const inFlightFetches = new Map<string, Promise<SearchItem[] | null>>();

  class BookSearch extends HTMLElement {
    private dialog!: HTMLDialogElement;
    private input!: HTMLInputElement;
    private clearBtn!: HTMLButtonElement;
    private closeBtn!: HTMLButtonElement;
    private list!: HTMLUListElement;
    private placeholder!: HTMLElement;
    private loadingEl!: HTMLElement;
    private emptyEl!: HTMLElement;

    private bookSlug = '';
    private selectedIndex = -1;
    private handleGlobalKeyDown!: (e: KeyboardEvent) => void;

    connectedCallback() {
      this.bookSlug = this.dataset.bookSlug || '';
      this.dialog = this.querySelector<HTMLDialogElement>('dialog')!;
      this.input = this.querySelector<HTMLInputElement>('[data-search-input]')!;
      this.clearBtn = this.querySelector<HTMLButtonElement>('[data-search-clear]')!;
      this.closeBtn = this.querySelector<HTMLButtonElement>('[data-search-close]')!;
      this.list = this.querySelector<HTMLUListElement>('[data-search-list]')!;
      this.placeholder = this.querySelector<HTMLElement>('[data-search-placeholder]')!;
      this.loadingEl = this.querySelector<HTMLElement>('[data-search-loading]')!;
      this.emptyEl = this.querySelector<HTMLElement>('[data-search-empty]')!;

      // Update shortcut badges based on OS (Ctrl K on Linux/Windows, ⌘K on Mac)
      const isMac = /(Mac|iPhone|iPod|iPad)/i.test(navigator.userAgent || '');
      document.querySelectorAll<HTMLElement>('[data-search-shortcut-badge]').forEach((badge) => {
        badge.textContent = isMac ? '⌘K' : 'Ctrl K';
      });

      // Wire up external search buttons on this page
      document.querySelectorAll<HTMLElement>('[data-open-book-search]').forEach((btn) => {
        btn.onclick = (e) => {
          e.preventDefault();
          this.openModal();
        };
      });

      // Close when clicking the backdrop (outside dialog's bounding rectangle)
      this.dialog.addEventListener('click', (e: MouseEvent) => {
        if (e.target === this.dialog) {
          const rect = this.dialog.getBoundingClientRect();
          const isInDialog =
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width;
          if (!isInDialog) {
            this.closeModal();
          }
        }
      });

      // Cleanup when dialog is closed (e.g. Esc key or method call)
      this.dialog.addEventListener('close', () => {
        this.resetSearchState();
      });

      this.closeBtn?.addEventListener('click', () => {
        this.closeModal();
      });

      this.clearBtn?.addEventListener('click', () => {
        this.input.value = '';
        this.input.focus();
        this.renderResults('');
      });

      this.input.addEventListener('input', () => {
        this.renderResults(this.input.value);
      });

      // Keyboard navigation in results
      this.input.addEventListener('keydown', (e: KeyboardEvent) => {
        const items = this.list.querySelectorAll<HTMLElement>('.book-search-item');
        if (!items.length) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          this.selectedIndex = (this.selectedIndex + 1) % items.length;
          this.updateActiveSelection();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          this.selectedIndex = (this.selectedIndex - 1 + items.length) % items.length;
          this.updateActiveSelection();
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (this.selectedIndex >= 0 && items[this.selectedIndex]) {
            items[this.selectedIndex].click();
          }
        }
      });

      // Global capture-phase shortcut: Ctrl+K / Cmd+K and '/'
      this.handleGlobalKeyDown = (e: KeyboardEvent) => {
        const isK = e.key === 'k' || e.key === 'K' || e.code === 'KeyK';
        const isModifier = e.metaKey || e.ctrlKey;

        if (isModifier && isK) {
          e.preventDefault();
          e.stopPropagation();
          if (this.dialog.open) {
            this.closeModal();
          } else {
            this.openModal();
          }
          return;
        }

        if (e.key === '/' && !this.dialog.open) {
          const active = document.activeElement as HTMLElement | null;
          const isInput =
            active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.isContentEditable);
          if (!isInput) {
            e.preventDefault();
            e.stopPropagation();
            this.openModal();
          }
        }
      };

      // Capture phase guarantees interception before browser addresses Ctrl+K on Linux/Windows
      window.addEventListener('keydown', this.handleGlobalKeyDown, true);

      // Pre-load the search index for this book right away so it is ready instantaneously
      this.fetchIndex();
    }

    disconnectedCallback() {
      window.removeEventListener('keydown', this.handleGlobalKeyDown, true);
      if (this.dialog && this.dialog.open) {
        this.dialog.close();
      }
    }

    private async fetchIndex(): Promise<SearchItem[] | null> {
      if (!this.bookSlug) return null;

      if (indexCache.has(this.bookSlug)) {
        return indexCache.get(this.bookSlug)!;
      }

      if (inFlightFetches.has(this.bookSlug)) {
        return inFlightFetches.get(this.bookSlug)!;
      }

      const fetchPromise = (async () => {
        try {
          const res = await fetch(`/books/${this.bookSlug}/search.json`);
          if (res.ok) {
            const data: SearchItem[] = await res.json();
            indexCache.set(this.bookSlug, data);
            // If the user already typed a query while waiting, refresh results now
            if (this.dialog.open && this.input.value.trim()) {
              this.renderResults(this.input.value);
            }
            return data;
          }
        } catch (err) {
          console.error('Failed to load book search index', err);
        } finally {
          inFlightFetches.delete(this.bookSlug);
        }
        return null;
      })();

      inFlightFetches.set(this.bookSlug, fetchPromise);
      return fetchPromise;
    }

    public async openModal() {
      if (this.dialog.open) return;
      this.dialog.showModal();
      this.input.focus();
      this.input.select();

      const cached = indexCache.get(this.bookSlug);
      if (!cached) {
        this.loadingEl.classList.remove('hidden');
        this.placeholder.classList.add('hidden');
        await this.fetchIndex();
        this.loadingEl.classList.add('hidden');
        if (!this.input.value.trim()) {
          this.placeholder.classList.remove('hidden');
        }
      }
    }

    public closeModal() {
      if (this.dialog.open) {
        this.dialog.close();
      }
    }

    private resetSearchState() {
      this.input.value = '';
      this.clearBtn.classList.add('hidden');
      this.list.innerHTML = '';
      this.loadingEl.classList.add('hidden');
      this.emptyEl.classList.add('hidden');
      this.placeholder.classList.remove('hidden');
      this.selectedIndex = -1;
    }

    private highlightMatches(text: string, terms: string[]): string {
      if (!terms.length) return text;
      const regex = new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\$&')).join('|')})`, 'gi');
      return text.replace(regex, '<mark class="bg-primary/20 text-primary font-semibold rounded-xs px-0.5">$1</mark>');
    }

    private getSnippet(text: string, terms: string[], maxLength = 120): string {
      if (!terms.length) return text.slice(0, maxLength) + (text.length > maxLength ? '…' : '');
      const lowerText = text.toLowerCase();
      let firstIdx = -1;
      for (const term of terms) {
        const idx = lowerText.indexOf(term.toLowerCase());
        if (idx !== -1 && (firstIdx === -1 || idx < firstIdx)) {
          firstIdx = idx;
        }
      }
      if (firstIdx === -1) return text.slice(0, maxLength) + (text.length > maxLength ? '…' : '');
      const start = Math.max(0, firstIdx - 40);
      const end = Math.min(text.length, firstIdx + maxLength - 40);
      const prefix = start > 0 ? '… ' : '';
      const suffix = end < text.length ? ' …' : '';
      return prefix + this.highlightMatches(text.slice(start, end), terms) + suffix;
    }

    private renderResults(query: string) {
      const q = query.trim().toLowerCase();

      if (!q) {
        this.clearBtn.classList.add('hidden');
        this.list.innerHTML = '';
        this.emptyEl.classList.add('hidden');
        this.loadingEl.classList.add('hidden');
        this.placeholder.classList.remove('hidden');
        this.selectedIndex = -1;
        return;
      }

      this.clearBtn.classList.remove('hidden');
      this.placeholder.classList.add('hidden');

      const data = indexCache.get(this.bookSlug);
      if (!data) {
        // Still loading index
        this.loadingEl.classList.remove('hidden');
        this.emptyEl.classList.add('hidden');
        this.list.innerHTML = '';
        return;
      }

      this.loadingEl.classList.add('hidden');

      const terms = q.split(/\s+/).filter(Boolean);
      const matches: Array<{ item: SearchItem; score: number }> = [];

      for (const item of data) {
        const titleLower = item.sceneTitle.toLowerCase();
        const chapterLower = item.chapterTitle.toLowerCase();
        const textLower = item.text.toLowerCase();

        let score = 0;
        let matched = true;

        for (const term of terms) {
          if (titleLower.includes(term)) {
            score += 10;
          } else if (chapterLower.includes(term)) {
            score += 5;
          } else if (textLower.includes(term)) {
            score += 2;
          } else {
            matched = false;
            break;
          }
        }

        if (matched && score > 0) {
          matches.push({ item, score });
        }
      }

      matches.sort((a, b) => b.score - a.score);

      if (!matches.length) {
        this.emptyEl.classList.remove('hidden');
        this.list.innerHTML = '';
        this.selectedIndex = -1;
        return;
      }

      this.emptyEl.classList.add('hidden');
      this.selectedIndex = 0;

      this.list.innerHTML = matches
        .slice(0, 15)
        .map(({ item }, idx) => {
          const highlightedTitle = this.highlightMatches(item.sceneTitle, terms);
          const snippet = this.getSnippet(item.text, terms);

          return `
            <li>
              <a
                href="${item.url}"
                data-result-index="${idx}"
                class="book-search-item block rounded-xl px-3.5 py-2.5 transition text-left cursor-pointer ${
                  idx === 0 ? 'bg-primary/10 dark:bg-primary/15' : 'hover:bg-gray-100 dark:hover:bg-slate-800'
                }"
              >
                <div class="flex items-center gap-2 text-xs text-muted mb-0.5">
                  <span>${item.chapterTitle}</span>
                  <span>›</span>
                  <span class="font-medium text-default">${highlightedTitle}</span>
                </div>
                <p class="text-xs text-muted/90 line-clamp-2 leading-relaxed">
                  ${snippet}
                </p>
              </a>
            </li>
          `;
        })
        .join('');

      // When result is clicked, close dialog before navigation
      this.list.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        link.addEventListener('click', () => {
          this.closeModal();
        });
      });
    }

    private updateActiveSelection() {
      const items = this.list.querySelectorAll<HTMLElement>('.book-search-item');
      items.forEach((item, idx) => {
        if (idx === this.selectedIndex) {
          item.classList.add('bg-primary/10', 'dark:bg-primary/15');
          item.classList.remove('hover:bg-gray-100', 'dark:hover:bg-slate-800');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-primary/10', 'dark:bg-primary/15');
          item.classList.add('hover:bg-gray-100', 'dark:hover:bg-slate-800');
        }
      });
    }
  }

  if (!customElements.get('book-search')) {
    customElements.define('book-search', BookSearch);
  }
</script>
