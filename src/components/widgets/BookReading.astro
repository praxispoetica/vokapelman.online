---
// Three-column reading layout (Starlight style):
// left: book title, cover thumbnail, chapter list
// center: chapter text (slot)
// right: "On this page" scene index with scroll-spy
// On small screens the side columns collapse into <details> menus above the text.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import BuyButtons from '~/components/widgets/BuyButtons.astro';
import BookSearchModal from '~/components/widgets/BookSearchModal.astro';

export interface Props {
  bookSlug?: string;
  bookTitle: string;
  bookHref: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  chapters: Array<{ title: string; href?: string; current: boolean; locked?: boolean }>;
  scenes: Array<{ text: string; slug: string }>;
  chapterTitle: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
  isLastChapter?: boolean;
  hasEofCutoff?: boolean;
  formats?: Array<{ format: string; label?: string; price?: string; buyUrl?: string }>;
  status?: 'available' | 'forthcoming';
}

const {
  bookSlug,
  bookTitle,
  bookHref,
  cover,
  coverAlt,
  chapters,
  scenes,
  chapterTitle,
  prev,
  next,
  isLastChapter = false,
  hasEofCutoff = false,
  formats = [],
  status = 'available',
} = Astro.props;
const linkBase = 'block rounded px-3 py-1.5 text-sm transition-colors';
---

<div class="book-reading max-w-screen-xl mx-auto px-4 sm:px-6 py-6 lg:py-10">
  <!-- Mobile menus -->
  <div class="lg:hidden space-y-2 mb-6">
    {
      bookSlug && (
        <button
          type="button"
          data-open-book-search
          class="w-full flex items-center justify-between px-3.5 py-2 text-sm text-muted bg-gray-100/90 hover:bg-gray-200/90 dark:bg-slate-800/90 dark:hover:bg-slate-700/90 rounded-xl border border-gray-200 dark:border-slate-700 transition cursor-pointer"
        >
          <span class="flex items-center gap-2">
            <Icon name="tabler:search" class="w-4 h-4 text-muted" />
            <span>Search in preview...</span>
          </span>
          <kbd
            data-search-shortcut-badge
            class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-700 text-muted"
          >
            Ctrl K
          </kbd>
        </button>
      )
    }
    <details class="rounded border border-gray-200 dark:border-slate-700 px-3 py-2">
      <summary class="cursor-pointer font-semibold">Chapters</summary>
      <ul class="mt-2">
        {
          chapters.map((c) => (
            <li>
              {c.locked || !c.href ? (
                <span class:list={[linkBase, 'text-muted/60 dark:text-slate-500 cursor-default select-none']}>
                  {c.title}
                </span>
              ) : (
                <a
                  href={c.href}
                  aria-current={c.current ? 'page' : undefined}
                  class:list={[
                    linkBase,
                    c.current
                      ? 'bg-primary/10 text-primary font-semibold'
                      : 'hover:bg-gray-100 dark:hover:bg-slate-800',
                  ]}
                >
                  {c.title}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </details>
    {
      scenes.length > 0 && (
        <details class="rounded border border-gray-200 dark:border-slate-700 px-3 py-2">
          <summary class="cursor-pointer font-semibold">On this page</summary>
          <ul class="mt-2">
            {scenes.map((s) => (
              <li>
                <a
                  href={`#${s.slug}`}
                  data-scene-link={s.slug}
                  class:list={[linkBase, 'hover:bg-gray-100 dark:hover:bg-slate-800']}
                >
                  {s.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>

  <div class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)_14rem] lg:gap-10">
    <!-- Left: book + chapters -->
    <aside class="hidden lg:block" aria-label="Book chapters">
      <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
        <a href={bookHref} class="block not-prose">
          <p class="font-heading text-xl font-bold leading-snug hover:text-primary">{bookTitle}</p>
          {cover && <Image src={cover} alt={coverAlt ?? bookTitle} width={120} class="mt-3 w-28 rounded shadow-md" />}
        </a>

        {
          bookSlug && (
            <button
              type="button"
              data-open-book-search
              class="w-full flex items-center justify-between px-3 py-2 text-sm text-muted bg-gray-100/80 hover:bg-gray-200/80 dark:bg-slate-800/80 dark:hover:bg-slate-700/80 rounded-lg border border-gray-200 dark:border-slate-700 transition my-4 group cursor-pointer"
            >
              <span class="flex items-center gap-2">
                <Icon name="tabler:search" class="w-4 h-4 text-muted group-hover:text-primary transition" />
                <span>Search preview...</span>
              </span>
              <kbd
                data-search-shortcut-badge
                class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-white dark:bg-slate-900 border border-gray-300 dark:border-slate-700 text-muted"
              >
                Ctrl K
              </kbd>
            </button>
          )
        }

        <nav class={bookSlug ? 'mt-2' : 'mt-6'}>
          <p class="mb-2 text-xs font-bold uppercase tracking-wide text-muted">Chapters</p>
          <ul>
            {
              chapters.map((c) => (
                <li>
                  {c.locked || !c.href ? (
                    <span class:list={[linkBase, 'text-muted/60 dark:text-slate-500 cursor-default select-none']}>
                      {c.title}
                    </span>
                  ) : (
                    <a
                      href={c.href}
                      aria-current={c.current ? 'page' : undefined}
                      class:list={[
                        linkBase,
                        c.current
                          ? 'bg-primary/10 text-primary font-semibold'
                          : 'hover:bg-gray-100 dark:hover:bg-slate-800',
                      ]}
                    >
                      {c.title}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>

    <!-- Center: reading -->
    <article class="min-w-0">
      <p class="text-sm text-muted lg:hidden"><a href={bookHref} class="hover:underline">{bookTitle}</a></p>
      <h1 class="text-3xl md:text-4xl font-bold font-heading leading-tighter mb-8">{chapterTitle}</h1>
      <div
        id="chapter-text"
        class="prose prose-lg dark:prose-invert max-w-none font-serif prose-headings:font-heading prose-headings:scroll-mt-24 prose-h2:text-2xl prose-a:text-primary"
      >
        <slot />
      </div>

      {
        isLastChapter && (
          <div class="mt-12 p-6 sm:p-8 rounded-2xl border border-gray-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/80 shadow-md not-prose">
            <h2 class="text-2xl font-bold font-heading mb-3">
              {hasEofCutoff ? 'End of free preview' : 'Thank you for reading'}
            </h2>
            <p class="text-muted text-base mb-6 font-sans">
              {hasEofCutoff
                ? `You have reached the end of the free online preview of "${bookTitle}". To continue reading the complete work, pick your format below:`
                : `You have reached the end of "${bookTitle}". Keep exploring or connect with the author:`}
            </p>
            {formats && formats.length > 0 && (
              <div class="mb-6">
                <BuyButtons formats={formats} status={status} />
              </div>
            )}
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-sans pt-4 border-t border-gray-100 dark:border-slate-800 text-muted">
              <a href="/#newsletter" class="text-primary hover:underline font-medium">
                Join on Substack for updates →
              </a>
              <span class="hidden sm:inline">·</span>
              <a href="/contact" class="text-primary hover:underline font-medium">
                Contact →
              </a>
            </div>
          </div>
        )
      }

      <nav
        class="mt-14 flex justify-between gap-4 border-t border-gray-200 dark:border-slate-700 pt-6"
        aria-label="Chapter navigation"
      >
        {
          prev ? (
            <a href={prev.href} class="text-primary hover:underline">
              ← {prev.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={next.href} class="text-primary hover:underline text-right">
              {next.title} →
            </a>
          ) : (
            <a href={bookHref} class="text-primary hover:underline text-right">
              Back to the book page
            </a>
          )
        }
      </nav>
    </article>

    <!-- Right: on this page -->
    <aside class="hidden lg:block" aria-label="On this page">
      {
        scenes.length > 0 && (
          <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto">
            <p class="mb-2 text-xs font-bold uppercase tracking-wide text-muted">On this page</p>
            <ul class="border-l border-gray-200 dark:border-slate-700">
              {scenes.map((s) => (
                <li>
                  <a
                    href={`#${s.slug}`}
                    data-scene-link={s.slug}
                    class="block border-l-2 border-transparent -ml-px px-3 py-1.5 text-sm text-muted hover:text-default transition-colors"
                  >
                    {s.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
  {bookSlug && <BookSearchModal bookSlug={bookSlug} bookTitle={bookTitle} />}
</div>

<style is:global>
  html:has(.book-reading) {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html:has(.book-reading) {
      scroll-behavior: auto;
    }
  }
  .book-reading [data-scene-link].is-active {
    color: var(--aw-color-primary, #2563eb);
    font-weight: 600;
  }
  .book-reading aside [data-scene-link].is-active {
    border-left-color: var(--aw-color-primary, #2563eb);
  }
  .book-reading #chapter-text p {
    line-height: 1.85;
  }
</style>

<script>
  // Scroll-spy: highlight the scene currently being read.
  const initScrollSpy = () => {
    const links = document.querySelectorAll<HTMLElement>('[data-scene-link]');
    const headings = Array.from(document.querySelectorAll<HTMLElement>('#chapter-text h2[id]'));
    if (links.length && headings.length && 'IntersectionObserver' in window) {
      const setActive = (id: string) =>
        links.forEach((l) => l.classList.toggle('is-active', l.dataset.sceneLink === id));
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length) setActive((visible[0].target as HTMLElement).id);
        },
        { rootMargin: '-80px 0px -65% 0px' }
      );
      headings.forEach((h) => observer.observe(h));
      if (headings[0]) setActive(headings[0].id);
    }
  };

  document.addEventListener('astro:page-load', initScrollSpy);
</script>
