---
import { Image } from "astro:assets";
import myLogoImage from '~/assets/images/logo.png'
import { SITE } from 'astrowind:config';
---

<span class="self-center ml-2 text-2xl font-bold text-gray-900 whitespace-nowrap dark:text-white flex items-center">
  <Image src={myLogoImage} alt="Site Logo" class="w-8 h-8 mr-2" />
  {SITE?.name}
</span>