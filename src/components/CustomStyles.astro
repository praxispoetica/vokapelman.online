---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(0 85 110);
    --aw-color-secondary: rgb(0 117 149);
    --aw-color-accent: rgb(134 213 245);

    --aw-color-text-heading: rgb(2 26 44);
    --aw-color-text-default: rgb(2 26 44);
    --aw-color-text-muted: rgb(29 93 137 / 84%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(2 26 44);

    ::selection {
      background-color: rgb(167 225 249);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    --aw-color-primary: rgb(0 117 149);
    --aw-color-secondary: rgb(134 213 245);
    --aw-color-accent: rgb(134 213 245);

    --aw-color-text-heading: rgb(255 255 255);
    --aw-color-text-default: rgb(223 240 255);
    --aw-color-text-muted: rgb(175 205 229 / 85%);
    --aw-color-bg-page: rgb(2 26 44);

    ::selection {
      background-color: rgb(134 213 245);
      color: rgb(2 26 44);
    }
  }
</style>