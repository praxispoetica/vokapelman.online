---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import BuyButtons from '~/components/widgets/BuyButtons.astro';
import Newsletter from '~/components/widgets/Newsletter.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: 'v. o. kapelman — Historical Fiction',
  ignoreTitleTemplate: true,
};

const works = await getCollection('works');
const featured = works.find((w) => w.data.featured) ?? works[0];
---

<Layout metadata={metadata}>
  {
    featured && (
      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-20 not-prose">
        <div class="grid gap-10 md:grid-cols-2 items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-secondary">Historical Fiction · Coming of Age</p>
            <h1 class="mt-3 text-5xl md:text-6xl font-bold font-heading leading-tighter">v. o. kapelman</h1>
            <p class="mt-6 text-xl text-muted">{featured.data.tagline ?? featured.data.blurb}</p>
            <div class="mt-8">
              <BuyButtons formats={featured.data.formats} status={featured.data.status} />
              <p class="mt-4">
                <a href={`/books/${featured.id}`} class="text-primary hover:underline">
                  Read an excerpt and learn more →
                </a>
              </p>
            </div>
          </div>
          <div class="flex justify-center">
            {featured.data.cover ? (
              <Image
                src={featured.data.cover}
                alt={featured.data.coverAlt ?? featured.data.title}
                class="w-72 rounded shadow-xl"
                widths={[300, 600]}
                sizes="300px"
                loading="eager"
              />
            ) : (
              <div class="aspect-[2/3] w-72 rounded shadow-xl bg-gray-100 dark:bg-slate-800 flex items-center justify-center p-6 text-center font-serif text-3xl text-muted">
                {featured.data.title}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 text-center">
    <h2 class="text-3xl font-bold font-heading">About the author</h2>
    <p class="mt-4 text-lg text-muted">
      Replace this with a short bio: where you come from, what draws you to history and the bildungsroman, and what
      you're writing next.
    </p>
    <div class="mt-6"><Button variant="secondary" href="/about">More about v. o. kapelman</Button></div>
  </section>

  <Newsletter
    id="newsletter"
    title="Join the reading list"
    subtitle="News of new releases, flash fiction, short stories and poetry collections, plus the occasional essay."
    disclaimer="No spam. Unsubscribe anytime."
  />

  <BlogLatestPosts
    id="journal"
    title="From the journal"
    information="Essays, research notes and the history behind the stories."
    count={3}
  />
</Layout>
