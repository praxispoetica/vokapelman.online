---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'About',
  description: 'About v. o. kapelman, author of historical coming-of-age fiction.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="About" title="v. o. kapelman" />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 prose prose-lg dark:prose-invert">
    <p>
      Replace this page with your author biography. Suggested outline: a short third-person bio, then a longer
      first-person note on how your own life shaped the novel, the historical period you write about, and your plans for
      upcoming collections of flash fiction, short stories and poetry.
    </p>
    <p>For press, events or rights inquiries, <a href="/contact">get in touch</a>.</p>
  </section>
</Layout>
