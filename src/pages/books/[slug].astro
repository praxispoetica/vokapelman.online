---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import BuyButtons from '~/components/widgets/BuyButtons.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { data } = work;
const { Content } = await render(work);

const metadata = {
  title: data.title,
  description: data.blurb,
  ...data.metadata,
};
---

<Layout metadata={metadata}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_2fr] items-start">
      <div>
        {
          data.cover ? (
            <Image
              src={data.cover}
              alt={data.coverAlt ?? data.title}
              class="w-full rounded shadow-lg"
              widths={[300, 600]}
              sizes="(min-width: 768px) 30vw, 90vw"
              loading="eager"
            />
          ) : (
            <div class="aspect-[2/3] w-full rounded shadow-lg bg-gray-100 dark:bg-slate-800 flex items-center justify-center p-6 text-center font-serif text-3xl text-muted">
              {data.title}
            </div>
          )
        }
      </div>
      <div>
        <h1 class="text-4xl md:text-5xl font-bold font-heading leading-tighter">{data.title}</h1>
        {data.subtitle && <p class="mt-1 text-xl text-muted">{data.subtitle}</p>}
        {data.tagline && <p class="mt-4 text-lg italic">{data.tagline}</p>}
        <p class="mt-6 text-lg whitespace-pre-line">{data.blurb}</p>
        <div class="mt-8">
          <BuyButtons
            formats={data.formats}
            status={data.status}
            readHref={data.readOnline ? `/books/${work.id}/read` : undefined}
          />
        </div>
        {
          data.praise.length > 0 && (
            <div class="mt-10 space-y-4">
              {data.praise.map((p) => (
                <blockquote class="border-l-4 border-primary pl-4">
                  <p class="italic">“{p.quote}”</p>
                  <footer class="text-sm text-muted">— {p.source}</footer>
                </blockquote>
              ))}
            </div>
          )
        }
      </div>
    </div>

    <article class="mt-16 prose prose-lg dark:prose-invert mx-auto max-w-3xl">
      <Content />
    </article>

    <p class="mt-12 text-center"><a href="/books" class="text-primary hover:underline">← All books</a></p>
  </section>
</Layout>
