---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Books',
  description: 'Novels, short stories, flash fiction and poetry by v. o. kapelman.',
};

const works = (await getCollection('works')).sort(
  (a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0)
);
const typeLabel: Record<string, string> = {
  novel: 'Novel',
  'flash-fiction': 'Flash Fiction',
  'short-stories': 'Short Stories',
  poetry: 'Poetry',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="Books" title="The Work" subtitle="Available now and on the way." />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
    <ul class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        works.map(({ id, data }) => (
          <li>
            <a href={`/books/${id}`} class="group block not-prose">
              {data.cover ? (
                <Image
                  src={data.cover}
                  alt={data.coverAlt ?? data.title}
                  class="w-full rounded shadow-md group-hover:shadow-xl transition"
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 30vw, 90vw"
                />
              ) : (
                <div class="aspect-[2/3] w-full rounded shadow-md bg-gray-100 dark:bg-slate-800 flex items-center justify-center p-6 text-center font-serif text-2xl text-muted">
                  {data.title}
                </div>
              )}
              <p class="mt-4 text-sm uppercase tracking-wide text-muted">
                {typeLabel[data.type]}
                {data.status === 'forthcoming' ? ' · Forthcoming' : ''}
              </p>
              <h2 class="text-xl font-bold group-hover:text-primary">{data.title}</h2>
              {data.tagline && <p class="text-muted">{data.tagline}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
