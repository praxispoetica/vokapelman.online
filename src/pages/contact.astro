---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Contact',
  description: 'Get in touch with v. o. kapelman for press, events, rights or reader questions.',
};

const contactEmail = 'vok@vokapelman.online';
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="Get in touch" />

  <ContactUs
    id="form"
    action={`mailto:${contactEmail}`}
    button="Send message"
    title="Send a message"
    subtitle="For press, events, rights inquiries, or just to say hello. Questions about an order? Include the email you used to buy."
    inputs={[
      { type: 'text', name: 'name', label: 'Name', required: true },
      { type: 'email', name: 'email', label: 'Email', required: true },
    ]}
    textarea={{ label: 'Message', name: 'message', rows: 5, required: true }}
    description={`I try to reply within a few days. You can also email directly at <a href="mailto:${contactEmail}" class="underline font-medium hover:text-primary">${contactEmail}</a>.`}
  />
</Layout>
